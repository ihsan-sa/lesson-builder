#!/usr/bin/env node
// Fake `claude` for tests/cancellation — first on PATH when the proxy under
// test starts. Speaks just enough of the CLI's -p protocol: `--version`;
// `--output-format json` (session init) prints a result object carrying a
// session_id; `--output-format stream-json` (a turn) reads the message from
// stdin and streams assistant events, then a result. A message containing
// LONG streams a chunk every 500ms for up to two minutes and forks bash+sleep
// underneath (the `; true` keeps bash from exec-ing straight into sleep, so
// the tree is three deep) so there is a real tree to kill; IGNORE_TERM makes every process
// in that tree ignore SIGTERM, so only the proxy's SIGKILL pass can end it;
// EXIT0_ON_TERM makes the CLI handle SIGTERM by reaping its child and exiting
// 0 with no result — a graceful shutdown the proxy must still count as cancelled.
const args = process.argv.slice(2);
if (args.includes("--version")) { console.log("fake-claude 0.0.0"); process.exit(0); }
let stdin = "";
process.stdin.on("data", (d) => (stdin += d));
process.stdin.on("end", main);
function main() {
  const fmt = args[args.indexOf("--output-format") + 1];
  const r = args.indexOf("--resume");
  const sid = r >= 0 ? args[r + 1] : require("crypto").randomUUID();
  const usage = { input_tokens: 1, output_tokens: 1 };
  const emit = (o) => process.stdout.write(JSON.stringify(o) + "\n");
  if (fmt === "json") { emit({ type: "result", session_id: sid, result: "Session ready.", usage, total_cost_usd: 0 }); return; }
  const long = /LONG/.test(stdin), ignoreTerm = /IGNORE_TERM/.test(stdin), exit0OnTerm = /EXIT0_ON_TERM/.test(stdin);
  if (ignoreTerm) process.on("SIGTERM", () => {});
  emit({ type: "system", subtype: "init", session_id: sid });
  if (!long) {
    emit({ type: "assistant", message: { content: [{ type: "text", text: "Quick reply." }] } });
    emit({ type: "result", session_id: sid, result: "Quick reply.", usage, total_cost_usd: 0 });
    return;
  }
  const child = require("child_process").spawn("bash", ["-c", (ignoreTerm ? "trap '' TERM; " : "") + "sleep 600; true"], { stdio: "ignore" });
  if (exit0OnTerm) process.on("SIGTERM", () => { child.kill("SIGKILL"); process.exit(0); });
  emit({ type: "assistant", message: { content: [{ type: "tool_use", name: "Bash", input: { command: "sleep 600" } }] } });
  let n = 0;
  const t = setInterval(() => {
    emit({ type: "assistant", message: { content: [{ type: "text", text: `chunk ${++n} ` }] } });
    if (n >= 240) { clearInterval(t); child.kill("SIGKILL"); emit({ type: "result", session_id: sid, result: "Long reply finished.", usage, total_cost_usd: 0 }); }
  }, 500);
}
